    "@types/website-scraper": "^1.2.11",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^5.11.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@jvhaile/cbe-verifier": "^1.0.7",
