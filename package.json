    "cbe",
    "telebirr",
    "bank",
    "receipt",
    "fintech",
    "typescript",
    "nodejs"
  ],
  "author": "Ato Codes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/atocodes/ethio-receipt-parser.git"
